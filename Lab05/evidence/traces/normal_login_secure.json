    "vulnerable_file": "vulnerable_queries.py",
    "vulnerable_function": "vulnerable_login",
    "vulnerable_lines": "18-35",
    "vulnerable_code": "def vulnerable_login(username: str, password: str) -> tuple[list, dict]:\n    digest = legacy_digest(password)\n    sql = (\n        \"SELECT id, username, display_name, role FROM users \"\n        f\"WHERE username = '{username}' AND legacy_password_digest = '{digest}'\"\n    )\n    started = perf_counter()\n    try:\n        rows = execute_read_only(sql)\n        error = None\n    except Exception as exc:\n        rows, error = [], exc\n    return rows, {\n        \"feature\": \"login\", \"mode\": \"vulnerable\", \"query_template\": LOGIN_TEMPLATE,\n        \"construction_method\": \"string_concatenation\", \"final_query_masked\": mask_query(sql, (digest,)),\n        \"placeholder_count\": 0, \"parameters_masked\": [], \"prepared\": False,\n        \"duration_ms\": round((perf_counter() - started) * 1000, 3), \"error\": error,\n    }",
    "vulnerable_explanation": "Username được nối vào SQL và legacy digest cố tình yếu.",
    "secure_file": "auth_service.py",
    "secure_function": "authenticate_secure",
    "secure_lines": "28-39",
    "secure_code": "def authenticate_secure(username: str, password: str) -> dict:\n    rows, query = secure_login_lookup(username)\n    row = rows[0] if rows else None\n    verified = bool(row and check_password_hash(row[\"password_hash\"], password))\n    user = ({key: row[key] for key in (\"id\", \"username\", \"display_name\", \"role\")} if verified else None)\n    return {\n        \"user\": user, \"rows\": rows, \"query\": query,\n        \"decision\": \"authenticated\" if verified else \"rejected\",\n        \"reason\": \"pbkdf2_verified\" if verified else \"invalid_credentials\",\n        \"password_verification_executed\": bool(row), \"password_verification_result\": verified,\n        \"password_length\": len(password),\n    }",
    "secure_explanation": "Username được bind; password được kiểm tra bằng check_password_hash."
