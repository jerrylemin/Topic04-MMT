FROM python:3.12-slim
WORKDIR /app
RUN useradd --create-home --uid 10002 labuser
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY attacker_app.py ./
COPY attacker_templates ./attacker_templates
COPY static/attacker ./static/attacker
USER labuser
EXPOSE 9004
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9004/health', timeout=2)"]
CMD ["python", "attacker_app.py"]
