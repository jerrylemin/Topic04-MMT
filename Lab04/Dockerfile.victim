FROM python:3.12-slim
WORKDIR /app
RUN useradd --create-home --uid 10001 labuser
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /app/data /app/evidence /app/report && chown -R labuser:labuser /app
USER labuser
EXPOSE 5004
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5004/health', timeout=2)"]
CMD ["python", "victim_app.py"]
